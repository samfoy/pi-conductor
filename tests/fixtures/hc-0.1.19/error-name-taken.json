{
  "hc": "0.1.19",
  "command": [
    "run",
    "--bg",
    "--json",
    "--outlive-parent",
    "--no-notify",
    "--name",
    "live1",
    "--cwd",
    "/tmp",
    "--",
    "sleep",
    "300"
  ],
  "exit": 1,
  "stdout": "",
